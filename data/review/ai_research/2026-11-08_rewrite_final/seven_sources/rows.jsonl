{"schema_version": "1.1.0", "id": "vilextime:T2:provision:089b0e44-39fb-11f1-a16c-4f6a99b9f514:2024-11-19", "lineage_id": "provision:089b0e44-39fb-11f1-a16c-4f6a99b9f514", "group": "T2", "split": null, "num_versions": 2, "num_transitions": 1, "question": "Tính đến ngày 19/11/2024, Khoản 2 Điều 18 Nghị định số 86/2018/NĐ-CP quy định nội dung gì?", "question_source": {"kind": "template", "id": "as_of_provision_text.v1"}, "as_of": "2024-11-19", "target": {"document_id": "document:131026", "law_id": "86/2018/NĐ-CP", "doc_type": "Nghị định", "document_title": "Nghị định số 86/2018/NĐ-CP quy định về hợp tác, đầu tư của nước ngoài trong lĩnh vực giáo dục", "article_id": "18", "clause_id": "2", "point_id": null, "citation": "Khoản 2 Điều 18", "provision_path": "Chương II › Mục 2 › Điều 18 › Khoản 2", "provision_id": "provision:089b0e44-39fb-11f1-a16c-4f6a99b9f514", "parent_id": "provision:0899aea0-39fb-11f1-96d5-e51561c1a5fe", "level": "Clause", "lead_in": "Điều 18. Cơ sở vật chất, thiết bị, địa điểm"}, "answer": "2. Đối với tổ chức thi cấp chứng chỉ năng lực ngoại ngữ của nước ngoài. Địa điểm, cơ sở vật chất, thiết bị và đội ngũ phục vụ liên kết tổ chức thi cấp chứng chỉ năng lực ngoại ngữ của nước ngoài phải bảo đảm chất lượng cho công tác tổ chức thi.", "answerable": true, "no_answer_reason": null, "in_force": true, "version_id": "version:089b0e44-39fb-11f1-a16c-4f6a99b9f514:1", "valid_from": "2018-08-01", "valid_to": "2024-11-20", "derivation": {"transitions": [{"on": "2024-11-20", "from_version": 1, "to_version": 2, "event_id": "event:170766:c1e54439d6841fc41de6bf66", "actor": {"law_id": "124/2024/NĐ-CP", "document_id": "document:170766", "effective_from": "2024-11-20"}, "op": "amend"}], "query": "as_of(provision:089b0e44-39fb-11f1-a16c-4f6a99b9f514, 2024-11-19)"}, "relevant_version_ids": ["version:089b0e44-39fb-11f1-a16c-4f6a99b9f514:1", "version:089b0e44-39fb-11f1-a16c-4f6a99b9f514:2"], "utilized_version_ids": ["version:089b0e44-39fb-11f1-a16c-4f6a99b9f514:1"], "sour