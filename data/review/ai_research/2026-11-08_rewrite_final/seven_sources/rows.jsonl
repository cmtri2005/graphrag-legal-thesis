{"schema_version": "1.1.0", "id": "vilextime:T2:provision:0b3d2a1c-df54-11f0-9582-0d0c91275f3e:2021-03-14", "lineage_id": "provision:0b3d2a1c-df54-11f0-9582-0d0c91275f3e", "group": "T2", "split": null, "num_versions": 2, "num_transitions": 1, "question": "Tính đến ngày 14/03/2021, Khoản 2 Điều 3 Thông tư số 13/2019/TT-BGTVT quy định nội dung gì?", "question_source": {"kind": "template", "id": "as_of_provision_text.v1"}, "as_of": "2021-03-14", "target": {"document_id": "document:135450", "law_id": "13/2019/TT-BGTVT", "doc_type": "Thông tư", "document_title": "Thông tư số 13/2019/TT-BGTVT Quy định chi tiết Chương trình an ninh hàng không và kiểm soát chất lượng an ninh hàng không Việt Nam", "article_id": "3", "clause_id": "2", "point_id": null, "citation": "Khoản 2 Điều 3", "provision_path": "Chương I › Điều 3 › Khoản 2", "provision_id": "provision:0b3d2a1c-df54-11f0-9582-0d0c91275f3e", "parent_id": "provision:0b3d2a08-df54-11f0-923e-35a0ea3bc556", "level": "Clause", "lead_in": "Trong Thông tư này các từ ngữ dưới đây được hiểu như sau:"}, "answer": "2. Điểm kiểm tra an ninh hàng không là vị trí làm việc của nhân viên kiểm soát an ninh hàng không được thiết lập tại các cổng, cửa, lối đi giữa khu vực công cộng và khu vực hạn chế hoặc giữa các khu vực hạn chế, nhằm kiểm tra an ninh hàng không người, phương tiện, đồ vật, duy trì an ninh trật tự khu vực điểm kiểm tra.", "answerable": true, "no_answer_reason": null, "in_force": true, "version_id": "version:0b3d2a1c-df54-11f0-9582-0d0c91275f3e:1", "valid_from": "2019-06-01", "valid_to": "2021-03-15", "derivation": {"transitions": [{"on": "2021-03-15", "from_version": 1, "to_version": 2, "event_id": "event:146881:38e8f46411991b4bfa68a875", "actor": {"law_id": "41/2020/TT-BGTVT", "document_id": "document:146881", "effective_from": "2021-03-15"}, "op": "amend"}], "query": "as_of(provision:0b3d2a1c-df54-11f0-9582-0d0c91275f3e, 2021-03-14)"}, "relevant_version_ids": ["version:0b3d2a1c-df54-11f0-9582-0d0c91275f3e:1", "version:0b3d